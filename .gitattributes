# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.md text
*.txt text
*.yml text
*.yaml text
*.css text
*.scss text
*.html text
*.xml text
*.svg text
*.csv text
*.sh text
*.env text

# Shell scripts should use LF only
*.sh text eol=lf

# Source files should use LF
*.ts eol=lf
*.tsx eol=lf
*.js eol=lf
*.jsx eol=lf
*.json eol=lf
*.md eol=lf
*.css eol=lf
*.scss eol=lf
*.html eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

