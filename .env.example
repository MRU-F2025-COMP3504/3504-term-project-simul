# Environment (development, production, test)
NODE_ENV=development

# Database connection string (includes host, port, user, password, and database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/simul_db

# Piston code execution API endpoint
PISTON_URL=http://localhost:2000

# Authentication secrets
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# GitHub OAuth credentials
GH_CLIENT_ID=
GH_SECRET=

# PostgreSQL database credentials and configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=simul_db

# Piston API port binding (container listens on 2000 internally)
PISTON_PORT=2000